# Copy to rustfs-replication.env on EACH NAS and customize locally.
# Pass it explicitly with: docker compose --env-file rustfs-replication.env ...
RUSTFS_IMAGE=rustfs/rustfs:1.0.1

# Example WireGuard IP for NAS A; use 10.77.0.2 on NAS B.
# The VPN must already be running before Docker publishes this address.
RUSTFS_BIND_IP=10.77.0.1
RUSTFS_S3_PORT=9002
RUSTFS_CONSOLE_PORT=9003

# Dedicated storage: do not share these paths with another running instance.
RUSTFS_DATA_DIR=/srv/rustfs-replication/data
RUSTFS_LOG_DIR=/srv/rustfs-replication/logs
RUSTFS_CERTS_DIR=/srv/rustfs-replication/certs

# Set independently on each NAS. Generate a secret: openssl rand -hex 32
# Leave neither value blank. Never commit this populated file.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
